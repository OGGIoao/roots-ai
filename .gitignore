# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Model weights (体积大, 不入库)
*.pth
*.pt
*.bin
*.safetensors

# 训练/推理产物 (可重新生成)
qlora_output/
checkpoints/
*.log
runs/

# 语料只有一份 (library/llm/bpe/data/), 其余项目经 common/corpus.py 直接读取,
# 不再生成各自的副本。

# 注意: 语料与 tokenizer 产物要入库!
# 旧规则曾写 `data/` 和 `tokenizer.json`, 会把 BPE 训练语料和 tokenizer 一起排除,
# 导致 clone 出来的仓库无法运行 —— 已改为精确规则, 不要改回去。
!library/llm/bpe/data/tinyshakespeare.txt
!library/llm/bpe/tokenizer.json
# 非默认配置训练出的 tokenizer 不入库 (见 train.py 的 --output)
library/llm/bpe/tokenizer_*.json

# Environment (密钥: 只提交 .env.example, .env 与 .env.local 等变体都不入库)
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# AI 助手会话/记忆日志 (本地工作笔记, 不属于项目资产)
.copilot-hub/

# 个人本地笔记 (私人约定、拆分前的原始 ROADMAP 等, 不公开)
.local/
