# ================================================================
# LLM 客户端模板 — 环境变量配置
# ================================================================
# 使用方式：
#   1. 将此文件复制为 .env（与 llm_client.py 放在同一目录）
#   2. 填入你的 API Key（带 <> 的需要替换）
#   3. 设置 LLM_PROVIDER 选择要使用的供应商
#
# ⚠️ 注意：.env 包含敏感信息，切勿提交到 Git 仓库。
# ================================================================

# ———— 供应商选择（必填） —————————————————————————————
# 可选值: deepseek | qwen | openai | ollama
# 修改此值即可切换 LLM，业务代码零改动
LLM_PROVIDER=deepseek

# ———— 模型覆盖（可选） ———————————————————————————————
# 不设则使用该供应商的 default_model
# LLM_MODEL=deepseek-chat

# ================================================================
# DeepSeek
# ================================================================
DEEPSEEK_API_KEY=sk-<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ================================================================
# Qwen（通义千问）
# ================================================================
QWEN_API_KEY=sk-<your-qwen-api-key>
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ================================================================
# OpenAI
# ================================================================
OPENAI_API_KEY=sk-<your-openai-api-key>
OPENAI_BASE_URL=https://api.openai.com/v1

# ================================================================
# Ollama（本地 / 自部署模型）
# ================================================================
# 适合：本地跑 llama3 / qwen2.5 / mistral 等开源模型
# Ollama 的 API Key 随意填（它不做校验），留空或填 "ollama" 即可
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
